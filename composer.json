{
    "name": "siddharthagf/xmorph",
    "description": "Radix-style asChild for Blade/Livewire components",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Pablo Santiago Guerra",
            "email": "livesanty_@hotmail.com",
            "homepage": "https://github.com/SiddharthaGF"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0",
        "illuminate/view": "^10.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "laravel/pint": "^1.31",
        "livewire/livewire": "^3.0",
        "orchestra/testbench": "^8.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "SiddharthaGF\\XMorph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SiddharthaGF\\XMorph\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SiddharthaGF\\XMorph\\XmorphServiceProvider"
            ]
        }
    },
    "scripts": {
        "pint": "vendor/bin/pint --parallel",
        "pint:test": "vendor/bin/pint --test --parallel",
        "phpstan": "vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "rector": "vendor/bin/rector process",
        "rector:dry": "vendor/bin/rector process --dry-run",
        "test": "vendor/bin/phpunit",
        "test:random": "vendor/bin/phpunit --order-by=random",
        "check": [
            "@pint:test",
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
